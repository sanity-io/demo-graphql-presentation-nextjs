{
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next",
    "format": "prettier --cache --write .",
    "graphql:deploy": "sanity graphql deploy",
    "lint": "next lint .",
    "presetup": "echo 'about to setup env variables, follow the guide here: https://github.com/sanity-io/demo-graphql-presentation-nextjs#using-the-sanity-cli'",
    "setup": "npx sanity@latest init --env .env.local",
    "postsetup": "echo 'create the read token by following the rest of the guide: https://github.com/sanity-io/demo-graphql-presentation-nextjs#creating-a-read-token'",
    "start": "next start"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-packagejson",
      "prettier-plugin-tailwindcss"
    ],
    "semi": false,
    "singleQuote": true
  },
  "dependencies": {
    "@sanity/assist": "3.2.2",
    "@sanity/client": "6.29.1",
    "@sanity/icons": "2.11.8",
    "@sanity/image-url": "1.2.0",
    "@sanity/preview-url-secret": "1.6.21",
    "@sanity/vision": "3.99.0",
    "@tailwindcss/typography": "0.5.16",
    "@types/node": "^20.19.13",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@urql/core": "5.2.0",
    "@vercel/speed-insights": "1.2.0",
    "autoprefixer": "10.4.21",
    "date-fns": "3.6.0",
    "next": "14.2.3",
    "next-sanity": "9.12.3",
    "postcss": "8.5.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2",
    "sanity": "3.99.0",
    "sanity-plugin-asset-source-unsplash": "3.1.0",
    "server-only": "0.0.1",
    "styled-components": "6.1.19",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.32",
    "prettier": "3.6.2",
    "prettier-plugin-packagejson": "2.5.19",
    "prettier-plugin-tailwindcss": "0.6.14"
  },
  "packageManager": "pnpm@9.1.1"
}
